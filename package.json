{
  "name": "@hey-research-lab/goat-plugin",
  "version": "0.1.0",
  "description": "GOAT SDK plugin for HEY Research Lab: Robinhood Chain builder research for AI agents — is a project still building, what it shipped, what changed and what HEY does not know, with evidence ids and links.",
  "license": "MIT",
  "author": "HEY Research Lab",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://heyresearch.xyz/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey-research-lab/hey-goat-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/hey-research-lab/hey-goat-plugin/issues"
  },
  "keywords": [
    "goat",
    "goat-sdk",
    "goat-plugin",
    "ai-agents",
    "agent-tools",
    "vercel-ai",
    "hey-research",
    "robinhood-chain",
    "builders",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "node scripts/scan.mjs .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hey-research-lab/sdk": "^0.2.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@goat-sdk/core": ">=0.4.9 <0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@goat-sdk/adapter-vercel-ai": "0.2.10",
    "@goat-sdk/core": "0.5.0",
    "@swc/core": "^1.15.0",
    "@types/node": "^22.10.0",
    "ai": "5.0.52",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
